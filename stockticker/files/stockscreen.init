#!/bin/sh /etc/rc.common
START=97
USE_PROCD=1
ORIG=/etc/stockscreen.orig

start_service() {
	# remember the user's own signature once, so stop/uninstall can put it back
	[ -f $ORIG ] || uci -q get gl_screen.generic.SIGNATURE > $ORIG
	procd_open_instance
	procd_set_param command /usr/bin/lua /usr/bin/stockscreen.lua
	procd_set_param respawn 3600 10 0
	procd_set_param nice 10
	procd_close_instance
}

stop_service() {
	restore_signature
}

restore_signature() {
	[ -f $ORIG ] || return 0
	lua -e '
local cjson = require "cjson"
local f = io.open("/etc/stockscreen.orig"); local v = f:read("*a"):gsub("\n$", ""); f:close()
v = v:gsub("^\"(.*)\"$", "%1")
local m = cjson.encode({method="config_update", params={config={SIGNATURE=v}}})
os.execute("ubus call gl_screen set \39" .. m:gsub("\39", "") .. "\39 >/dev/null 2>&1")'
}
